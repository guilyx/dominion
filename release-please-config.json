{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "dominion",
      "changelog-path": "CHANGELOG.md",
      "include-component-in-tag": false,
      "bump-minor-pre-major": false,
      "bump-patch-for-minor-pre-major": false,
      "draft": false,
      "prerelease": false,
      "changelog-sections": [
        { "type": "feat", "section": "Features" },
        { "type": "fix", "section": "Fixes" },
        { "type": "perf", "section": "Performance" },
        { "type": "balance", "section": "Game balance" },
        { "type": "refactor", "section": "Internals", "hidden": true },
        { "type": "docs", "section": "Documentation", "hidden": true },
        { "type": "chore", "section": "Chores", "hidden": true },
        { "type": "test", "section": "Tests", "hidden": true },
        { "type": "build", "section": "Build", "hidden": true },
        { "type": "ci", "section": "CI", "hidden": true }
      ]
    }
  },
  "$comment": "Tags are v-prefixed (v1.2.3). Merging a release PR tags the commit, writes CHANGELOG.md and publishes a GitHub Release; the release workflow then attaches the desktop binaries."
}
